<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@color/background_main">

    <TextView
        android:id="@+id/tvCartTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="КОРЗИНА"
        android:textStyle="bold"
        android:textSize="24sp"
        android:textAlignment="center"
        android:layout_marginBottom="15dp"
        android:textColor="@color/black"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/tvCartList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        />

    <TextView
        android:id="@+id/tvCartTitleSum"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ИТОГО: 0"
        android:textColor="@color/black"
        android:textSize="30sp"
        android:paddingBottom="12dp"
        android:paddingTop="12dp"/>

    <Button
        android:id="@+id/btnMakeOrder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ОФОРМИТЬ ЗАКАЗ"
        android:backgroundTint="#FB4654"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <Button
    android:id="@+id/btnClearCart"
    android:layout_width="0dp"
            android:layout_weight="1"
    android:layout_height="wrap_content"
    android:text="ОЧИСТИТЬ КОРЗИНУ"
            android:textColor="@color/black"
            android:backgroundTint="#9DF0A1"/>

        <Button
            android:id="@+id/btnOoenHistory"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="ОТКРЫТЬ ИСТОРИЮ"
            android:textColor="@color/black"
            android:backgroundTint="#9DF0A1"/>
</LinearLayout>


</LinearLayout>